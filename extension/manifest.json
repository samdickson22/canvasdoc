{
  "manifest_version": 3,
  "name": "Canvasdoc",
  "description": "Your local coursework agent, with Canvas assignments, course materials, and a persistent workspace.",
  "content_scripts": [
    {
      "matches": [],
      "css": [
        "bootstrap.css"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [],
      "js": [
        "canvasdoc.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf/viewer.html",
        "mermaid.js"
      ],
      "matches": []
    }
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.instructureusercontent.com/*"
  ],
  "key": ""
}
