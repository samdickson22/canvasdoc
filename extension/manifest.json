{
  "manifest_version": 3,
  "name": "Canvasdoc",
  "version": "0.1.12",
  "description": "Your local coursework agent, with Canvas assignments, course materials, and a persistent workspace.",
  "content_scripts": [
    {
      "matches": [
        "https://mac-mini.tail39179a.ts.net:3211/*",
        "http://localhost:3210/*",
        "https://canvas.calpoly.edu/*"
      ],
      "css": [
        "bootstrap.css"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mac-mini.tail39179a.ts.net:3211/*",
        "http://localhost:3210/*",
        "https://canvas.calpoly.edu/*"
      ],
      "js": [
        "canvasdoc.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://mac-mini.tail39179a.ts.net:3211/*",
    "http://localhost:3210/*",
    "https://*.instructure.com/*",
    "https://*.instructureusercontent.com/*",
    "https://canvas.calpoly.edu/*"
  ],
  "key": ""
}
